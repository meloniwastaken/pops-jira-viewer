{
  "name": "@meloniwastaken/pops-jira-viewer",
  "version": "0.1.0",
  "description": "Viewer degli sprint Jira del Portale Operatori Sanitari: aree, funzionalità e task, con le azioni di tutti i giorni",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/meloniwastaken/pops-jira-viewer.git"
  },
  "homepage": "https://github.com/meloniwastaken/pops-jira-viewer#readme",
  "bugs": "https://github.com/meloniwastaken/pops-jira-viewer/issues",
  "author": "Marco Meloni",
  "type": "module",
  "bin": {
    "pops-jira-viewer": "bin/cli.js"
  },
  "files": [
    "bin/",
    "dist/",
    "server/",
    "!server/**/*.test.js"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web \"node --watch server/avvio-dev.js\" \"vite\"",
    "build": "vite build",
    "start": "node bin/cli.js",
    "test": "node --test \"server/**/*.test.js\"",
    "prepublishOnly": "npm test && npm run build"
  },
  "dependencies": {
    "express": "^5.1.0",
    "open": "^10.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.0",
    "concurrently": "^9.1.0",
    "dompurify": "^3.2.0",
    "vite": "^7.0.0",
    "vue": "^3.5.0"
  },
  "keywords": [
    "jira",
    "sprint",
    "viewer",
    "pops"
  ],
  "license": "ISC"
}
